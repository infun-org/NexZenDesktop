<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NexZen.Application.ViewModels"
        xmlns:conv="using:NexZen.Desktop.Converters"
        x:Class="NexZen.Desktop.Views.SitePrivacyWindow"
        x:DataType="vm:SitePrivacyViewModel"
        Width="1000" Height="700" MinWidth="760" MinHeight="460"
        Title="Privacy and security"
        Icon="avares://NexZen.Desktop/Assets/icon64.ico"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <Window.Resources>
    <conv:DataUrlToBitmapConverter x:Key="DataUrlBitmap"/>
    <conv:PathDataToGeometryConverter x:Key="PathGeometry"/>
  </Window.Resources>
  <Window.Styles>
    <!-- Same as the ConfirmPrompt buttons: red for destructive, green for positive. -->
    <Style Selector="Button.Negative">
      <Setter Property="Background" Value="#F3C7BC"/>
      <Setter Property="Foreground" Value="#5A2E26"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.Negative:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#EBB3A6"/>
    </Style>
    <Style Selector="Button.Positive">
      <Setter Property="Background" Value="#C4F0D0"/>
      <Setter Property="Foreground" Value="#1F4A2C"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.Positive:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#AFE6BE"/>
    </Style>
    <Style Selector="TextBlock.SectionTitle">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#555555"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="ListBox.Sites ListBoxItem">
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="CornerRadius" Value="8"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="ListBox.Sites ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#EDEDED"/>
    </Style>
    <Style Selector="ListBox.Sites ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3F3F3"/>
    </Style>
    <Style Selector="TextBox.Filter">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="12,8,34,8"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="BorderBrush" Value="#C9C9C9"/>
      <Setter Property="Background" Value="White"/>
    </Style>
  </Window.Styles>

  <Border CornerRadius="16" BorderBrush="#D8D8D8" BorderThickness="1" Margin="8" Background="#F3F3F3"
          PointerPressed="Background_PointerPressed">
    <Border.Effect>
      <DropShadowDirectionEffect ShadowDepth="2" BlurRadius="10" Color="#18000000" />
    </Border.Effect>
    <Grid RowDefinitions="Auto,*,Auto" Margin="16,10,16,14">
      <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,8">
        <TextBlock Text="Privacy and security" FontSize="20" FontWeight="SemiBold" Foreground="#2A2A2A"
                   VerticalAlignment="Center"/>
        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="6" CornerRadius="12"
                Cursor="Hand" VerticalAlignment="Center" ToolTip.Tip="Close (Esc)" Command="{Binding CloseCommand}">
          <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                    Width="12" Height="12" Foreground="#666666"/>
        </Button>
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="250,14,*">
        <!-- Sites on this page -->
        <Grid RowDefinitions="Auto,*">
          <Panel>
            <TextBox Classes="Filter" Text="{Binding Filter}" PlaceholderText="Filter site on this page"/>
            <PathIcon Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z"
                      Width="16" Height="16" Foreground="#555555" HorizontalAlignment="Right" Margin="0,0,12,0"
                      IsHitTestVisible="False"/>
          </Panel>
          <Border Grid.Row="1" Margin="0,10,0,0" Background="White" BorderBrush="#C9C9C9" BorderThickness="1"
                  CornerRadius="10" Padding="8">
            <Panel>
              <ListBox Classes="Sites" ItemsSource="{Binding Sites}" SelectedItem="{Binding SelectedSite}"
                       Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SitePrivacySite">
                    <Grid ColumnDefinitions="30,*">
                      <Panel Width="20" Height="20" VerticalAlignment="Center">
                        <PathIcon Data="M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2M18.92,8H15.97C15.65,6.75 15.19,5.55 14.59,4.44C16.43,5.07 17.96,6.35 18.92,8M12,4.04C12.83,5.24 13.5,6.57 13.91,8H10.09C10.5,6.57 11.17,5.24 12,4.04M4.26,14C4.1,13.36 4,12.69 4,12C4,11.31 4.1,10.64 4.26,10H7.64C7.56,10.66 7.5,11.32 7.5,12C7.5,12.68 7.56,13.34 7.64,14H4.26M5.08,16H8.03C8.35,17.25 8.81,18.45 9.41,19.56C7.57,18.93 6.04,17.65 5.08,16M8.03,8H5.08C6.04,6.35 7.57,5.07 9.41,4.44C8.81,5.55 8.35,6.75 8.03,8M12,19.96C11.17,18.76 10.5,17.43 10.09,16H13.91C13.5,17.43 12.83,18.76 12,19.96M14.34,14H9.66C9.57,13.34 9.5,12.68 9.5,12C9.5,11.32 9.57,10.65 9.66,10H14.34C14.43,10.65 14.5,11.32 14.5,12C14.5,12.68 14.43,13.34 14.34,14M14.59,19.56C15.19,18.45 15.65,17.25 15.97,16H18.92C17.96,17.65 16.43,18.93 14.59,19.56M16.36,14C16.44,13.34 16.5,12.68 16.5,12C16.5,11.32 16.44,10.66 16.36,10H19.74C19.9,10.64 20,11.31 20,12C20,12.69 19.9,13.36 19.74,14H16.36Z"
                                  Width="18" Height="18" Foreground="#7A7A7A"
                                  IsVisible="{Binding FaviconDataUrl, Converter={x:Static StringConverters.IsNullOrEmpty}}"/>
                        <Image Source="{Binding FaviconDataUrl, Converter={StaticResource DataUrlBitmap}}" Width="20" Height="20"
                               IsVisible="{Binding FaviconDataUrl, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                      </Panel>
                      <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Text="{Binding Host}" FontSize="15" Foreground="#2A2A2A" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding UsageText}" FontSize="13" Foreground="#666666"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="No sites on this page." Foreground="#888888" FontSize="13" Margin="8"
                         IsVisible="{Binding HasNoSites}"/>
            </Panel>
          </Border>
        </Grid>

        <!-- Selected site -->
        <Grid Grid.Column="2" RowDefinitions="Auto,*" IsVisible="{Binding HasSelection}">
          <TextBlock Text="{Binding SelectedHost}" FontSize="16" Foreground="#2A2A2A" Margin="2,6,0,8"
                     TextTrimming="CharacterEllipsis"/>
          <!-- Sits straight on the window background (no white card). -->
          <Border Grid.Row="1">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" Padding="2,6,8,14">
              <StackPanel Spacing="4">
                <TextBlock Classes="SectionTitle" Text="Usage"/>
                <Grid ColumnDefinitions="*,Auto" Margin="40,4,0,10">
                  <TextBlock Text="{Binding SelectedUsage}" FontSize="14" Foreground="#3A3A3A" VerticalAlignment="Center"/>
                  <Button Grid.Column="1" Classes="Negative" Content="{Binding DeleteLabel}" Command="{Binding DeleteDataCommand}"/>
                </Grid>

                <Border Height="1" Background="#E0E0E0" Margin="0,2,0,8"/>

                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                  <TextBlock Classes="SectionTitle" Text="Permissions"/>
                  <Button Grid.Column="1" Classes="Positive" Content="Reset permissions" Command="{Binding ResetPermissionsCommand}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Permissions}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SitePermission">
                      <Grid ColumnDefinitions="40,*,210" MinHeight="48" Margin="0,2">
                        <PathIcon Data="{Binding IconData, Converter={StaticResource PathGeometry}}" Width="17" Height="17" Foreground="#555555"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2" Margin="6,0,10,0">
                          <TextBlock Text="{Binding Label}" FontSize="14" Foreground="#2A2A2A"/>
                          <TextBlock Text="{Binding Description}" FontSize="13" Foreground="#666666" TextWrapping="Wrap"
                                     IsVisible="{Binding HasDescription}"/>
                        </StackPanel>
                        <ComboBox Grid.Column="2" ItemsSource="{Binding Choices}" SelectedIndex="{Binding SelectedIndex}"
                                  HorizontalAlignment="Stretch" VerticalAlignment="Center" CornerRadius="8"/>
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>
      </Grid>

      <TextBlock Grid.Row="2" Text="{Binding StatusText}" Foreground="#4A4A4A" FontSize="13" Margin="4,8,0,0"
                 IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </Grid>
  </Border>
</Window>
