<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:NexZen.Application.ViewModels"
        x:Class="NexZen.Desktop.Views.WorkspaceEditorWindow"
        x:DataType="vm:WorkspaceEditorViewModel"
        Width="480" Height="640" MinWidth="380" MinHeight="420"
        Title="New workspace"
        Icon="avares://NexZen.Desktop/Assets/icon64.ico"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
  <!-- Pinned: stays on top and does not hide when the browser takes focus, so links can be copied in. -->
  <Window.Styles>
    <Style Selector="Button.Pill">
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="HorizontalAlignment" Value="Stretch"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.GreenPill">
      <Setter Property="Background" Value="#C4F0D0"/>
      <Setter Property="BorderBrush" Value="#7FCF97"/>
      <Setter Property="Foreground" Value="#1F4A2C"/>
    </Style>
    <Style Selector="Button.GreenPill:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#AFE6BE"/>
    </Style>
    <Style Selector="Button.BluePill">
      <Setter Property="Background" Value="#BFE4F6"/>
      <Setter Property="BorderBrush" Value="#7DB9DB"/>
      <Setter Property="Foreground" Value="#1F3A4D"/>
    </Style>
    <Style Selector="Button.BluePill:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#A9D7EE"/>
    </Style>
    <Style Selector="Button.YellowPill">
      <Setter Property="Background" Value="#FCEFB4"/>
      <Setter Property="BorderBrush" Value="#E2CC6B"/>
      <Setter Property="Foreground" Value="#4A3D10"/>
    </Style>
    <Style Selector="Button.YellowPill:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F7E595"/>
    </Style>
    <Style Selector="Button.IconOnly">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="4"/>
      <Setter Property="CornerRadius" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="Button.Swatch">
      <Setter Property="BorderBrush" Value="#C8C8C8"/>
      <Setter Property="BorderThickness" Value="1"/>
    </Style>
    <Style Selector="Button.Swatch.Selected">
      <Setter Property="BorderBrush" Value="#2A2A2A"/>
      <Setter Property="BorderThickness" Value="3"/>
    </Style>
    <Style Selector="TextBox.Soft">
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#BDBDBD"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Padding" Value="12,8"/>
    </Style>
  </Window.Styles>

  <Border CornerRadius="16" BorderBrush="#D8D8D8" BorderThickness="1" Margin="8" Background="#F3F3F3"
          PointerPressed="Header_PointerPressed">
    <Border.Effect>
      <DropShadowDirectionEffect ShadowDepth="2" BlurRadius="10" Color="#18000000" />
    </Border.Effect>
    <Grid RowDefinitions="Auto,Auto,Auto,*,Auto,Auto" Margin="14,10,14,12">
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <TextBlock Text="Name workspace" FontSize="17" FontWeight="SemiBold" Foreground="#2A2A2A" VerticalAlignment="Center"/>
        <Button Grid.Column="1" Classes="IconOnly" ToolTip.Tip="Close" Command="{Binding CloseCommand}">
          <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                    Width="14" Height="14" Foreground="#666666"/>
        </Button>
      </Grid>

      <StackPanel Grid.Row="1" Margin="0,8,0,10" Spacing="8">
        <TextBox Classes="Soft" Name="NameBox" Text="{Binding Name}" PlaceholderText="Workspace" MinHeight="46"/>
        <!-- Border color for the card and the windows opened from this workspace. -->
        <ItemsControl ItemsSource="{Binding Colors}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="6"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:WorkspaceColorChoice">
              <Button Classes="Swatch" Width="30" Height="30" Padding="0" CornerRadius="15" Cursor="Hand" ToolTip.Tip="{Binding Name}"
                      Background="Transparent"
                      Classes.Selected="{Binding IsSelected}"
                      Command="{Binding $parent[ItemsControl].((vm:WorkspaceEditorViewModel)DataContext).PickColorCommand}"
                      CommandParameter="{Binding}">
                <Grid>
                <!-- The color is drawn here: the button's own background changes on hover. -->
                <Border Width="24" Height="24" CornerRadius="12"
                        Background="{Binding Hex, Converter={StaticResource HexToBrushConverter}, ConverterParameter=#FFFFFF}"/>
                <PathIcon IsVisible="{Binding Hex, Converter={x:Static ObjectConverters.IsNull}}"
                          Data="M12,2C17.5,2 22,6.5 22,12C22,17.5 17.5,22 12,22C6.5,22 2,17.5 2,12C2,6.5 6.5,2 12,2M12,4C10.1,4 8.4,4.6 7.1,5.7L18.3,16.9C19.3,15.5 20,13.8 20,12C20,7.6 16.4,4 12,4M16.9,18.3L5.7,7.1C4.6,8.4 4,10.1 4,12C4,16.4 7.6,20 12,20C13.9,20 15.6,19.4 16.9,18.3Z"
                          Width="16" Height="16" Foreground="#9A9A9A"/>
                </Grid>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Grid Grid.Row="2" ColumnDefinitions="*,8,Auto" Margin="0,0,0,8">
        <Button Grid.Column="0" Classes="Pill GreenPill" Content="Add all tab on this window" Command="{Binding AddAllTabsCommand}"/>
        <Button Grid.Column="2" Classes="Pill BluePill" Content="Add URL" Padding="22,7" Command="{Binding AddUrlCommand}"/>
      </Grid>

      <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#BDBDBD" BorderThickness="1" CornerRadius="10" Padding="6">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Entries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:WorkspaceEditorEntry">
                <Grid Margin="0,2">
                  <!-- Saved row: name and a remove cross on the right. -->
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !IsEditing}" Margin="4,0,0,0" ToolTip.Tip="{Binding Url}">
                    <TextBlock Text="{Binding Title}" FontSize="17" Foreground="#2A2A2A" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Classes="IconOnly" ToolTip.Tip="Remove"
                            Command="{Binding $parent[ItemsControl].((vm:WorkspaceEditorViewModel)DataContext).RemoveEntryCommand}"
                            CommandParameter="{Binding}">
                      <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                Width="16" Height="16" Foreground="#D9473B"/>
                    </Button>
                  </Grid>
                  <!-- Row being typed: cancel cross on the left, confirm tick inside the box. -->
                  <Grid ColumnDefinitions="Auto,*" IsVisible="{Binding IsEditing}">
                    <Button Classes="IconOnly" ToolTip.Tip="Cancel"
                            Command="{Binding $parent[ItemsControl].((vm:WorkspaceEditorViewModel)DataContext).RemoveEntryCommand}"
                            CommandParameter="{Binding}">
                      <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                Width="16" Height="16" Foreground="#D9473B"/>
                    </Button>
                    <Grid Grid.Column="1" Margin="6,0,0,0">
                      <TextBox Classes="Soft" Text="{Binding EditText}" PlaceholderText="Paste a link"
                               Padding="12,8,40,8" MinHeight="46" KeyDown="UrlBox_KeyDown"
                               AttachedToVisualTree="UrlBox_Attached"/>
                      <Button Classes="IconOnly" HorizontalAlignment="Right" Margin="0,0,6,0" ToolTip.Tip="Add"
                              Command="{Binding $parent[ItemsControl].((vm:WorkspaceEditorViewModel)DataContext).ConfirmEntryCommand}"
                              CommandParameter="{Binding}">
                        <PathIcon Data="M21,7L9,19L3.5,13.5L4.91,12.09L9,16.17L19.59,5.59L21,7Z" Width="18" Height="18" Foreground="#4CAF50"/>
                      </Button>
                    </Grid>
                  </Grid>
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Border>

      <TextBlock Grid.Row="4" Text="{Binding StatusText}" Foreground="#8A4A3A" FontSize="13" TextWrapping="Wrap" Margin="2,6,2,0"
                 IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

      <Button Grid.Row="5" Classes="Pill YellowPill" Content="{Binding SaveLabel}" Margin="0,8,0,0" Command="{Binding SaveCommand}"/>
    </Grid>
  </Border>
</Window>
