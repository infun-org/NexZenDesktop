<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NexZen.Desktop.Views.PasswordAutofillPickerWindow"
        Width="380" Height="300" MinWidth="320" MinHeight="180"
        CanResize="False" WindowStartupLocation="CenterOwner"
        WindowDecorations="None" ShowInTaskbar="False"
        Background="Transparent" TransparencyLevelHint="Transparent"
        Title="Choose saved login">
    <Border Background="#F3F3F3" BorderBrush="#CCCCCC" BorderThickness="1"
            CornerRadius="8" Padding="18" Margin="10"
            BoxShadow="0 4 30 0 #E6000000">
        <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10">
            <TextBlock Text="Choose a saved login" FontSize="17" FontWeight="Bold" Foreground="#292929" />
            <TextBlock x:Name="SiteText" Grid.Row="1" TextWrapping="Wrap" Foreground="#606060" />
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="AccountsPanel" Spacing="6" />
            </ScrollViewer>
            <Button Grid.Row="3" Content="Cancel" HorizontalAlignment="Right" MinWidth="82"
                    Click="Cancel_Click" />
        </Grid>
    </Border>
</Window>
