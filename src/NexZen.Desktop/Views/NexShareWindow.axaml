<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:NexZen.Desktop.Views"
        mc:Ignorable="d" d:DesignWidth="1130" d:DesignHeight="640"
        Width="1130" Height="640"
        MinWidth="990" MinHeight="560"
        x:Class="NexZen.Desktop.Views.NexShareWindow"
        Title="NexShare"
        Icon="avares://NexZen.Desktop/Assets/icon64.ico"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        Deactivated="Window_Deactivated">
    <views:NexShareView />
</Window>
