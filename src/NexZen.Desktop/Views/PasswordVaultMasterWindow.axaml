<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NexZen.Desktop.Views.PasswordVaultMasterWindow"
        Width="440" Height="410" MinWidth="440" MinHeight="320"
        CanResize="False" WindowStartupLocation="CenterOwner"
        WindowDecorations="None" ShowInTaskbar="False"
        Background="Transparent" TransparencyLevelHint="Transparent"
        Title="NexZen password vault">
    <Border Background="#F3F3F3" BorderBrush="#D8D8D8" BorderThickness="1"
            CornerRadius="16" Padding="16" Margin="12"
            BoxShadow="0 2 10 0 #18000000">
        <Border.Styles>
            <Style Selector="TextBox.PinDigit">
                <Setter Property="Width" Value="48" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="48" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="20" />
                <Setter Property="Foreground" Value="#2A2A2A" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#D8D8D8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="TextBox.PinDigit:focus">
                <Setter Property="BorderBrush" Value="#A9D7EE" />
            </Style>
            <Style Selector="TextBox.Soft">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="12,8" />
                <Setter Property="Background" Value="#FFFFFF" />
                <Setter Property="BorderBrush" Value="#D8D8D8" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Foreground" Value="#2A2A2A" />
            </Style>
            <Style Selector="Button.Negative">
                <Setter Property="Background" Value="#F3C7BC" />
                <Setter Property="Foreground" Value="#5A2E26" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="Button.Negative:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#EBB3A6" />
            </Style>
            <Style Selector="Button.Neutral">
                <Setter Property="Background" Value="#BFE4F6" />
                <Setter Property="Foreground" Value="#1F3A4D" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="Button.Neutral:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#A9D7EE" />
            </Style>
            <Style Selector="Button.Positive">
                <Setter Property="Background" Value="#C4F0D0" />
                <Setter Property="Foreground" Value="#1F4A2C" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
            </Style>
            <Style Selector="Button.Positive:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="#AFE6BE" />
            </Style>
        </Border.Styles>

        <StackPanel Spacing="10">
            <TextBlock x:Name="HeadingText" Text="NexZen Password" FontSize="16" FontWeight="Bold" Foreground="#2A2A2A" />
            <TextBlock x:Name="InstructionsText" TextWrapping="Wrap" FontSize="14" Foreground="#4A4A4A" />

            <StackPanel x:Name="PinEntryPanel" Spacing="6">
                <TextBlock x:Name="PinLabel" Text="NexZen PIN" FontSize="13" Foreground="#4A4A4A" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox x:Name="PinDigit1" Classes="PinDigit" Width="48" MinWidth="0" MaxLength="1" PasswordChar="●" TextChanged="PinDigit_TextChanged" />
                    <TextBox x:Name="PinDigit2" Classes="PinDigit" Width="48" MinWidth="0" MaxLength="1" PasswordChar="●" TextChanged="PinDigit_TextChanged" />
                    <TextBox x:Name="PinDigit3" Classes="PinDigit" Width="48" MinWidth="0" MaxLength="1" PasswordChar="●" TextChanged="PinDigit_TextChanged" />
                    <TextBox x:Name="PinDigit4" Classes="PinDigit" Width="48" MinWidth="0" MaxLength="1" PasswordChar="●" TextChanged="PinDigit_TextChanged" />
                    <TextBox x:Name="PinDigit5" Classes="PinDigit" Width="48" MinWidth="0" MaxLength="1" PasswordChar="●" TextChanged="PinDigit_TextChanged" />
                    <TextBox x:Name="PinDigit6" Classes="PinDigit" Width="48" MinWidth="0" MaxLength="1" PasswordChar="●" TextChanged="PinDigit_TextChanged" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="ConfirmationEntryPanel" Spacing="6" IsVisible="False">
                <TextBlock Text="Confirm PIN" FontSize="13" Foreground="#4A4A4A" />
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBox x:Name="ConfirmPinDigit1" Classes="PinDigit" Width="48" MinWidth="0" MaxLength="1" PasswordChar="●" TextChanged="ConfirmPinDigit_TextChanged" />
                    <TextBox x:Name="ConfirmPinDigit2" Classes="PinDigit" Width="48" MinWidth="0" MaxLength="1" PasswordChar="●" TextChanged="ConfirmPinDigit_TextChanged" />
                    <TextBox x:Name="ConfirmPinDigit3" Classes="PinDigit" Width="48" MinWidth="0" MaxLength="1" PasswordChar="●" TextChanged="ConfirmPinDigit_TextChanged" />
                    <TextBox x:Name="ConfirmPinDigit4" Classes="PinDigit" Width="48" MinWidth="0" MaxLength="1" PasswordChar="●" TextChanged="ConfirmPinDigit_TextChanged" />
                    <TextBox x:Name="ConfirmPinDigit5" Classes="PinDigit" Width="48" MinWidth="0" MaxLength="1" PasswordChar="●" TextChanged="ConfirmPinDigit_TextChanged" />
                    <TextBox x:Name="ConfirmPinDigit6" Classes="PinDigit" Width="48" MinWidth="0" MaxLength="1" PasswordChar="●" TextChanged="ConfirmPinDigit_TextChanged" />
                </StackPanel>
            </StackPanel>

            <TextBox x:Name="RecoveryInput" Classes="Soft" PlaceholderText="Recovery key" MinHeight="40" IsVisible="False" />
            <TextBlock x:Name="ErrorText" Foreground="#5A2E26" FontSize="13" TextWrapping="Wrap" />
            <Border x:Name="RecoveryPanel" IsVisible="False" Background="#FFFFFF" Padding="12"
                    CornerRadius="14" BorderBrush="#E4E4E4" BorderThickness="1">
                <StackPanel Spacing="6">
                    <TextBlock Text="Write down this recovery key. It is shown only once." FontWeight="SemiBold" Foreground="#2A2A2A" TextWrapping="Wrap" />
                    <TextBox x:Name="RecoveryDisplay" Classes="Soft" IsReadOnly="True" TextWrapping="Wrap" MinHeight="54" />
                    <TextBlock Text="Anyone with this key can unlock your saved passwords." FontSize="12" Foreground="#4A4A4A" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Button x:Name="RecoveryModeButton" Classes="Neutral" Content="Use recovery key" Click="RecoveryMode_Click"
                    HorizontalAlignment="Left" Cursor="Hand" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0" Spacing="8">
                <Button x:Name="SkipButton" Classes="Neutral" Content="Skip" Click="Skip_Click" MinWidth="78" IsVisible="False" Cursor="Hand" />
                <Button x:Name="CancelButton" Classes="Negative" Content="Cancel" Click="Cancel_Click" MinWidth="78" Cursor="Hand" />
                <Button x:Name="ContinueButton" Classes="Positive" Content="Continue" Click="Continue_Click" MinWidth="96" IsDefault="True" Cursor="Hand" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
