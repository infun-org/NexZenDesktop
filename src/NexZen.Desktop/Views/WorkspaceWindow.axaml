<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:NexZen.Desktop.Views"
        Width="1296" Height="960"
        MinWidth="936" MinHeight="520"
        x:Class="NexZen.Desktop.Views.WorkspaceWindow"
        Title="NexZen workspace"
        Icon="avares://NexZen.Desktop/Assets/icon64.ico"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        WindowDecorations="None"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        Deactivated="Window_Deactivated">
    <!-- Same window shape, size and corner placement as AiFunctionWindow. -->
    <views:WorkspaceView />
</Window>
