<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="NexZen.Desktop.Views.IncognitoWindow"
        Title="Incognito Mode - NexZen Desktop"
        Icon="avares://NexZen.Desktop/Assets/icon64.ico"
        Width="1100" Height="760"
        MinWidth="640" MinHeight="420"
        Background="#202124"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="Button.nav">
      <Setter Property="Width" Value="32"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="Margin" Value="0,0,4,0"/>
      <Setter Property="Padding" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="CornerRadius" Value="16"/>
      <Setter Property="Foreground" Value="#E8EAED"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Cursor" Value="Hand"/>
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#3C4043"/>
    </Style>
    <Style Selector="Button.nav:disabled">
      <Setter Property="Opacity" Value="0.35"/>
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,Auto,*">
    <Border Grid.Row="0" Background="#292A2D" Padding="8,6,8,4">
      <Grid ColumnDefinitions="*,Auto">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <StackPanel Name="TabStrip" Orientation="Horizontal" Spacing="4"/>
        </ScrollViewer>
        <Button Name="NewTabButton" Grid.Column="1" Classes="nav" Margin="6,0,0,0" ToolTip.Tip="New tab (Ctrl+T)" Click="NewTabButton_Click">
          <PathIcon Width="16" Height="16" Foreground="#E8EAED" Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z"/>
        </Button>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#3C4043" Padding="12,6">
      <TextBlock Text="Incognito mode. Pages opened here are not saved to history."
                 Foreground="#E8EAED" FontSize="13" VerticalAlignment="Center"/>
    </Border>

    <Border Grid.Row="2" Background="#292A2D" BorderBrush="#3C4043" BorderThickness="0,0,0,1" Padding="8,6">
      <Grid ColumnDefinitions="Auto,Auto,Auto,*">
        <Button Name="BackButton" Grid.Column="0" Classes="nav" ToolTip.Tip="Back" Click="BackButton_Click">
          <PathIcon Width="16" Height="16" Foreground="#E8EAED" Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z"/>
        </Button>
        <Button Name="ForwardButton" Grid.Column="1" Classes="nav" ToolTip.Tip="Forward" Click="ForwardButton_Click">
          <PathIcon Width="16" Height="16" Foreground="#E8EAED" Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z"/>
        </Button>
        <Button Name="RefreshButton" Grid.Column="2" Classes="nav" Margin="0,0,8,0" ToolTip.Tip="Refresh" Click="RefreshButton_Click">
          <PathIcon Width="14" Height="14" Foreground="#E8EAED" Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4.01,7.58 4.01,12C4.01,16.42 7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z"/>
        </Button>
        <TextBox Name="AddressBox" Grid.Column="3" PlaceholderText="Search or enter address"
                 KeyDown="AddressBox_KeyDown" KeyUp="AddressBox_KeyUp"
                 Background="#202124" Foreground="#E8EAED" BorderThickness="0"
                 CornerRadius="16" Padding="14,0" Height="34" FontSize="15" VerticalAlignment="Center"/>
      </Grid>
    </Border>

    <Grid Name="PageHost" Grid.Row="3" Background="#FFFFFF" ClipToBounds="True"/>

    <Grid Name="SuggestLayer" Grid.Row="3" ZIndex="2" IsVisible="False">
      <Border Name="SuggestBackdrop" Background="#01000000"/>
      <Border HorizontalAlignment="Stretch" VerticalAlignment="Top" Margin="120,6,12,0" MaxHeight="240"
              Background="#35363A" BorderBrush="#5F6368" BorderThickness="1"
              CornerRadius="8" Padding="8" BoxShadow="0 4 10 0 #66000000">
        <StackPanel>
          <TextBlock Text="Search suggestions" FontWeight="Bold" FontSize="14" Foreground="#E8EAED" Margin="4,2,4,2"/>
          <ScrollViewer MaxHeight="180">
            <StackPanel Name="SuggestList"/>
          </ScrollViewer>
        </StackPanel>
      </Border>
    </Grid>

    <Border Name="PermissionLayer" Grid.RowSpan="4" ZIndex="4" IsVisible="False" Background="#99000000">
      <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="420"
              Background="#35363A" BorderBrush="#5F6368" BorderThickness="1"
              CornerRadius="12" Padding="18" BoxShadow="0 8 24 0 #80000000">
        <StackPanel Spacing="14">
          <TextBlock Name="PermissionText" Foreground="#E8EAED" FontSize="14" TextWrapping="Wrap"/>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Name="PermissionDenyButton" Content="Deny" Click="PermissionDeny_Click"
                    MinWidth="88" Height="34" Padding="14,0" CornerRadius="8"
                    Background="#3C4043" Foreground="#E8EAED" BorderThickness="0" Cursor="Hand"/>
            <Button Name="PermissionAllowButton" Content="Allow" Click="PermissionAllow_Click"
                    MinWidth="88" Height="34" Padding="14,0" CornerRadius="8"
                    Background="#8AB4F8" Foreground="#202124" BorderThickness="0" Cursor="Hand"/>
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</Window>
