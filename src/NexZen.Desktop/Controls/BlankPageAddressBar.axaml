<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:NexZen.Application.ViewModels"
             xmlns:sys="using:System"
             x:Class="NexZen.Desktop.Controls.BlankPageAddressBar"
             x:DataType="vm:MainViewModel"
             HorizontalAlignment="Center"
             VerticalAlignment="Top">
    <!-- Address bar shown on top of a new tab (about:blank). Mirrors the SuperMenu address bar. -->
    <UserControl.Styles>

        <!-- Style for the Star Button in Address bar -->
        <Style Selector="Button.StarBtn > PathIcon">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="Data" Value="M22,9.24L14.81,8.62L12,2L9.19,8.63L2,9.24L7.46,13.97L5.82,21L12,17.27L18.18,21L16.54,13.97L22,9.24M12,15.4L8.24,17.67L9.24,13.39L5.92,10.51L10.3,10.13L12,6.1L13.71,10.14L18.09,10.52L14.77,13.4L15.77,17.68L12,15.4Z" />
        </Style>
        <Style Selector="Button.StarBtn.IsBookmarked > PathIcon">
            <Setter Property="Foreground" Value="#FFC107" />
            <Setter Property="Data" Value="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.63L2,9.24L7.46,13.97L5.82,21L12,17.27Z" />
        </Style>
        <Style Selector="Button.QuickLink:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#EEF1F4" />
        </Style>
        <Style Selector="Button.Suggestion">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="FontSize" Value="15" />
        </Style>
        <Style Selector="Button.Suggestion:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C0DBF3" />
        </Style>
        <Style Selector="Button.Suggestion.suggestion-selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#C0DBF3" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="4" Width="560" MaxWidth="560">
        <Border Name="AddressBarBorder" Padding="10,6"
                Background="#FFFFFF"
                BorderBrush="#CCCCCC" BorderThickness="1"
                CornerRadius="8"
                BoxShadow="0 2 5 0 #60000000">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                <Button x:Name="LockDomainButton" Grid.Column="0" Click="LockDomain_Click"
                        Background="Transparent" Padding="0" Margin="0,0,6,0" Width="24" Height="28"
                        ToolTip.Tip="Lock this domain with your NexZen PIN">
                    <PathIcon Data="M18,8H17V6C17,3.24 14.76,1 12,1C9.24,1 7,3.24 7,6V8H6C4.9,8 4,8.9 4,10V20C4,21.1 4.9,22 6,22H18C19.1,22 20,21.1 20,20V10C20,8.9 19.1,8 18,8M9,6C9,4.34 10.34,3 12,3C13.66,3 15,4.34 15,6V8H9V6M18,20H6V10H18V20M12,17C13.1,17 14,16.1 14,15C14,13.9 13.1,13 12,13C10.9,13 10,13.9 10,15C10,16.1 10.9,17 12,17Z"
                              Foreground="#4CAF50" Width="16" Height="16" />
                </Button>

                <TextBox x:Name="UrlTextBox" Grid.Column="1" SelectionBrush="#900000" SelectionForegroundBrush="#FFFFFF"
                         KeyDown="AddressBar_KeyDown" KeyUp="AddressBar_KeyUp" GotFocus="AddressBar_GotFocus"
                         Text="{Binding CurrentUrl}" Background="Transparent" BorderThickness="0"
                         VerticalAlignment="Center" FontSize="16" Foreground="#333" />

                <Button Grid.Column="2" Classes="StarBtn" Classes.IsBookmarked="{Binding IsCurrentUrlBookmarked}" Command="{Binding ToggleBookmarkCommand}" Background="Transparent" Margin="10,0,0,0" Width="30" Height="30" CornerRadius="15">
                    <PathIcon Width="18" Height="18" />
                </Button>

                <Button Grid.Column="3" Background="Transparent" Margin="5,0,0,0" Padding="5,0" Height="30" CornerRadius="15" ToolTip.Tip="Choose search engine">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding SearchEngineLabel}" VerticalAlignment="Center" FontSize="14" Foreground="#666" />
                        <PathIcon Data="M7,10L12,15L17,10H7Z" Width="10" Height="10" Foreground="#666" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Google" Command="{Binding SetSearchEngineCommand}" CommandParameter="Google">
                                <MenuItem.Icon>
                                    <PathIcon Data="M21.35,11.1H12.18V13.83H18.69C18.36,17.64 15.19,19.27 12.19,19.27C8.36,19.27 5,16.25 5,12C5,7.9 8.2,4.73 12.2,4.73C15.29,4.73 17.1,6.7 17.1,6.7L19,4.72C19,4.72 16.56,2 12.1,2C6.42,2 2.03,6.8 2.03,12C2.03,17.05 6.16,22 12.25,22C17.6,22 21.5,18.33 21.5,12.91C21.5,11.76 21.35,11.1 21.35,11.1Z" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Bing" Command="{Binding SetSearchEngineCommand}" CommandParameter="Bing">
                                <MenuItem.Icon>
                                    <PathIcon Data="M5,3V19L8.72,21L18,15.82V11.73H10.83V8.32L14.28,6.89V11.26H17.47L17.5,6.08L5,3Z" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="DuckDuckGo" Command="{Binding SetSearchEngineCommand}" CommandParameter="DuckDuckGo">
                                <MenuItem.Icon>
                                    <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12.61,16.5C11.66,16.5 10.95,15.7 10.95,14.73C10.95,14 11.39,13.25 12,13C12,13.6 12.64,13.92 13.16,13.71C13.59,13.54 13.95,13.04 13.95,12.55C13.95,11.72 13.18,11.14 12.44,11.14C11.75,11.14 11,11.71 11,12.43C11,13 11.23,13.27 11.5,13.5C11.53,13.53 11.56,13.55 11.56,13.58C11.56,13.63 11.5,13.68 11.45,13.68C11,13.68 9.9,13 9.9,11.5C9.9,9.45 11.65,8 13.81,8C15.85,8 17.5,9.43 17.5,11.5C17.5,13 16.4,13.68 15.93,13.68C15.88,13.68 15.84,13.63 15.84,13.58C15.84,13.55 15.87,13.53 15.9,13.5C16.16,13.27 16.4,13 16.4,12.43C16.4,11.71 15.65,11.14 14.95,11.14C14.21,11.14 13.44,11.72 13.44,12.55C13.44,13.04 13.8,13.54 14.23,13.71C14.75,13.92 15.39,13.6 15.39,13C16,13.25 16.44,14 16.44,14.73C16.44,15.7 15.73,16.5 14.78,16.5H12.61Z" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Cốc Cốc" Command="{Binding SetSearchEngineCommand}" CommandParameter="CocCoc">
                                <MenuItem.Icon>
                                    <PathIcon Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12.92,16.5L8.71,11.96L8.68,16.5H7.2V7.5H8.71L12.92,12.04L12.96,7.5H14.44V16.5H12.92Z" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </Border>

        <!-- Search suggestions while typing -->
        <Border Name="SuggestionBorder" IsVisible="False" Padding="6"
                Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8"
                BoxShadow="0 2 5 0 #60000000">
            <ItemsControl Name="SuggestionItems" ItemsSource="{Binding SearchSuggestions}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="sys:String">
                        <Button Classes="Suggestion" Click="SuggestionItem_Click" Tag="{Binding}">
                            <Grid ColumnDefinitions="Auto,*">
                                <PathIcon Grid.Column="0" Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" Width="14" Height="14" Foreground="#666" Margin="0,0,10,0" />
                                <TextBlock Grid.Column="1" Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="#333" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <!-- Shortcuts to often-used sites (QuickLinkStore), filled in code. -->
        <!-- Light backing so names stay readable over a background picture. -->
        <Border HorizontalAlignment="Center" Margin="0,28,0,0" Padding="6" CornerRadius="16" Background="#CCFFFFFF">
            <WrapPanel Name="QuickLinksPanel" HorizontalAlignment="Center" ItemWidth="80" ItemHeight="88" />
        </Border>
    </StackPanel>
</UserControl>
