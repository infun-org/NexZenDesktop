<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="500"
             x:Class="NexZen.Desktop.Controls.SuperMenuControl"
             xmlns:vm="using:NexZen.Application.ViewModels"
             xmlns:models="using:NexZen.Core.Entities"
             xmlns:sys="using:System"
             x:DataType="vm:MainViewModel"
             Focusable="True">
    <UserControl.Styles>
        <!-- Style for the top row icon buttons -->
        <Style Selector="Button.IconBtn">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Background" Value="#F5F5F5" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="16" />
        </Style>
        <Style Selector="Button.IconBtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C0DBF3" />
        </Style>

        <Style Selector="Border.ListItem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="38" />
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <!-- Style for the list buttons -->
        <Style Selector="Button.ListItem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#00D0D0D0" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style Selector="Button.ListItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C0DBF3" />
        </Style>
        <Style Selector="Button.ListItem.suggestion-selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#C0DBF3" />
        </Style>
        <Style Selector="Button.ListItem:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.ListItem:disabled:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <!-- Style for the highlighted list button -->
        <Style Selector="Border.HighlightItem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="#E8F5E9" />
            <Setter Property="BorderBrush" Value="#81C784" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="12,0" />
        </Style>

        <!-- Style for the Star Button in Address bar -->
        <Style Selector="Button.StarBtn > PathIcon">
            <Setter Property="Foreground" Value="#666666" />
            <Setter Property="Data" Value="M22,9.24L14.81,8.62L12,2L9.19,8.63L2,9.24L7.46,13.97L5.82,21L12,17.27L18.18,21L16.54,13.97L22,9.24M12,15.4L8.24,17.67L9.24,13.39L5.92,10.51L10.3,10.13L12,6.1L13.71,10.14L18.09,10.52L14.77,13.4L15.77,17.68L12,15.4Z" />
        </Style>
        <Style Selector="Button.StarBtn.IsBookmarked > PathIcon">
            <Setter Property="Foreground" Value="#FFC107" />
            <Setter Property="Data" Value="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.63L2,9.24L7.46,13.97L5.82,21L12,17.27Z" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="5">
        <!-- Address Bar -->
        <Border Name="AddressBarBorder" Padding="10,6"
                Background="#FFFFFF"
                BorderBrush="#CCCCCC" BorderThickness="1"
                CornerRadius="8"
                BoxShadow="0 2 5 0 #60000000">
            <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
                <!-- Back -->
                <Button Name="BackButton" Grid.Column="0" Click="BackButton_Click" ContextRequested="BackButton_ContextRequested" Background="Transparent" Margin="0,0,5,0" Width="30" Height="30" CornerRadius="15">
                    <PathIcon Data="M15.41,16.58L10.83,12L15.41,7.41L14,6L8,12L14,18L15.41,16.58Z" Width="14" Height="14" Foreground="#333" />
                </Button>
                <!-- Forward -->
                <Button Grid.Column="1" Click="ForwardButton_Click" Background="Transparent" Margin="0,0,10,0" Width="30" Height="30" CornerRadius="15">
                    <PathIcon Data="M8.59,16.58L13.17,12L8.59,7.41L10,6L16,12L10,18L8.59,16.58Z" Width="14" Height="14" Foreground="#333" />
                </Button>
                
                <!-- Lock this domain -->
                <Button x:Name="LockDomainButton" Grid.Column="2" Click="LockDomain_Click"
                        Background="Transparent" Padding="0" Margin="0,0,6,0" Width="24" Height="28"
                        ToolTip.Tip="Lock this domain with your NexZen PIN">
                    <PathIcon Data="M18,8H17V6C17,3.24 14.76,1 12,1C9.24,1 7,3.24 7,6V8H6C4.9,8 4,8.9 4,10V20C4,21.1 4.9,22 6,22H18C19.1,22 20,21.1 20,20V10C20,8.9 19.1,8 18,8M9,6C9,4.34 10.34,3 12,3C13.66,3 15,4.34 15,6V8H9V6M18,20H6V10H18V20M12,17C13.1,17 14,16.1 14,15C14,13.9 13.1,13 12,13C10.9,13 10,13.9 10,15C10,16.1 10.9,17 12,17Z"
                              Foreground="#4CAF50" Width="16" Height="16" />
                </Button>
                
                <!-- URL Box -->
                <TextBox x:Name="UrlTextBox" SelectionBrush="#900000" SelectionForegroundBrush="#FFFFFF" Grid.Column="3" KeyDown="AddressBar_KeyDown" KeyUp="AddressBar_KeyUp" Text="{Binding CurrentUrl}" Background="Transparent" BorderThickness="0" VerticalAlignment="Center" FontSize="16" Foreground="#333" Width="250" />
                
                <!-- Star Icon -->
                <Button Grid.Column="4" Classes="StarBtn" Classes.IsBookmarked="{Binding IsCurrentUrlBookmarked}" Command="{Binding ToggleBookmarkCommand}" Background="Transparent" Margin="10,0,0,0" Width="30" Height="30" CornerRadius="15">
                    <PathIcon Width="18" Height="18" />
                </Button>
                
                <!-- Search Engine Selector -->
                <Button Grid.Column="5" Background="Transparent" Margin="5,0,0,0" Padding="5,0" Height="30" CornerRadius="15" ToolTip.Tip="Choose search engine">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <TextBlock Text="{Binding SearchEngineLabel}" VerticalAlignment="Center" FontSize="14" Foreground="#666" />
                        <PathIcon Data="M7,10L12,15L17,10H7Z" Width="10" Height="10" Foreground="#666" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="Google" Command="{Binding SetSearchEngineCommand}" CommandParameter="Google">
                                <MenuItem.Icon>
                                    <PathIcon Data="M21.35,11.1H12.18V13.83H18.69C18.36,17.64 15.19,19.27 12.19,19.27C8.36,19.27 5,16.25 5,12C5,7.9 8.2,4.73 12.2,4.73C15.29,4.73 17.1,6.7 17.1,6.7L19,4.72C19,4.72 16.56,2 12.1,2C6.42,2 2.03,6.8 2.03,12C2.03,17.05 6.16,22 12.25,22C17.6,22 21.5,18.33 21.5,12.91C21.5,11.76 21.35,11.1 21.35,11.1Z" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Bing" Command="{Binding SetSearchEngineCommand}" CommandParameter="Bing">
                                <MenuItem.Icon>
                                    <PathIcon Data="M5,3V19L8.72,21L18,15.82V11.73H10.83V8.32L14.28,6.89V11.26H17.47L17.5,6.08L5,3Z" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="DuckDuckGo" Command="{Binding SetSearchEngineCommand}" CommandParameter="DuckDuckGo">
                                <MenuItem.Icon>
                                    <PathIcon Data="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A10,10 0 0,0 22,12A10,10 0 0,0 12,2M12.61,16.5C11.66,16.5 10.95,15.7 10.95,14.73C10.95,14 11.39,13.25 12,13C12,13.6 12.64,13.92 13.16,13.71C13.59,13.54 13.95,13.04 13.95,12.55C13.95,11.72 13.18,11.14 12.44,11.14C11.75,11.14 11,11.71 11,12.43C11,13 11.23,13.27 11.5,13.5C11.53,13.53 11.56,13.55 11.56,13.58C11.56,13.63 11.5,13.68 11.45,13.68C11,13.68 9.9,13 9.9,11.5C9.9,9.45 11.65,8 13.81,8C15.85,8 17.5,9.43 17.5,11.5C17.5,13 16.4,13.68 15.93,13.68C15.88,13.68 15.84,13.63 15.84,13.58C15.84,13.55 15.87,13.53 15.9,13.5C16.16,13.27 16.4,13 16.4,12.43C16.4,11.71 15.65,11.14 14.95,11.14C14.21,11.14 13.44,11.72 13.44,12.55C13.44,13.04 13.8,13.54 14.23,13.71C14.75,13.92 15.39,13.6 15.39,13C16,13.25 16.44,14 16.44,14.73C16.44,15.7 15.73,16.5 14.78,16.5H12.61Z" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Header="Cốc Cốc" Command="{Binding SetSearchEngineCommand}" CommandParameter="CocCoc">
                                <MenuItem.Icon>
                                    <PathIcon Data="M12,2C6.48,2 2,6.48 2,12C2,17.52 6.48,22 12,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 12,2M12.92,16.5L8.71,11.96L8.68,16.5H7.2V7.5H8.71L12.92,12.04L12.96,7.5H14.44V16.5H12.92Z" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>

                
            </Grid>
        </Border>

        <!-- Context Menu Items -->
        <Border Background="#fafafa"
                BorderBrush="#CCCCCC"
                BorderThickness="1"
                CornerRadius="8"
                Padding="8"
                HorizontalAlignment="Left"
                BoxShadow="5 5 20 0 #4d000000"
                Margin="0,4,30,30">
            <Grid>
                <StackPanel Name="MainMenuList">
                <!-- FitToViewport caps this when the expanded list is taller than the window. -->
                <ScrollViewer Name="MainMenuScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Border Classes="ListItem" Margin="0,0,0,4">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Image Grid.Column="0"
                                   Source="{Binding ActiveTab.FaviconSource}"
                                   Width="18"
                                   Height="18"
                                   Margin="2,0,8,0"
                                   VerticalAlignment="Center"
                                   Stretch="Uniform"
                                   IsVisible="{Binding ActiveTab.FaviconSource, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            <TextBlock Grid.Column="1"
                                       Text="{Binding ActiveTab.Title}"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="#333333"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="240"
                                       ToolTip.Tip="{Binding ActiveTab.Title}" />
                            <Button Grid.Column="2"
                                    Width="24"
                                    Height="24"
                                    Padding="0"
                                    Margin="8,0,0,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="CloseActiveTab_Click"
                                    ToolTip.Tip="Close tab"
                                    Cursor="Hand">
                                <PathIcon Data="M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z"
                                          Width="14" Height="14" Foreground="#E53935" />
                            </Button>
                        </Grid>
                    </Border>
                    <!-- Top Icons Row -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,4">
                        <Button Classes="IconBtn" Click="TabManagerButton_Click" ToolTip.Tip="Tab Manager" FontWeight="Bold" Background="#FFCBCB" BorderBrush="#FFF8AFAF">
                            <TextBlock Name="TabCountLabel" Text="1" />
                        </Button>
                        <Button Classes="IconBtn" Click="NewTabButton_Click" ToolTip.Tip="New Tab">
                            <PathIcon Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" Width="16" Height="16" Foreground="#333" />
                        </Button>
                        <Button Classes="IconBtn" Click="RefreshButton_Click" ToolTip.Tip="Refresh">
                            <PathIcon Data="M17.65,6.35C16.2,4.9 14.21,4 12,4C7.58,4 4.01,7.58 4.01,12C4.01,16.42 7.58,20 12,20C15.73,20 18.84,17.45 19.73,14H17.65C16.83,16.33 14.61,18 12,18C8.69,18 6,15.31 6,12C6,8.69 8.69,6 12,6C13.66,6 15.14,6.69 16.22,7.78L13,11H20V4L17.65,6.35Z" Width="14" Height="14" Foreground="#333" />
                        </Button>
                        <Button Name="WorkspaceButton" Classes="IconBtn" Click="WorkspaceButton_Click" ToolTip.Tip="Workspace (Ctrl+Shift+W)">
                            <PathIcon Data="M13,3V9H21V3M13,21H21V11H13M3,21H11V15H3M3,13H11V3H3V13Z" Width="14" Height="14" Foreground="#333" />
                        </Button>
                        <Button Classes="IconBtn" Click="ShowBookmarkList_Click" ToolTip.Tip="Bookmarks">
                            <PathIcon Data="M17,3H7C5.9,3 5.01,3.9 5.01,5L5,21L12,18L19,21V5C19,3.9 18.1,3 17,3Z" Width="14" Height="14" Foreground="#333" />
                        </Button>
                        <Button Classes="IconBtn" Click="ShowVisitHistory_Click" ToolTip.Tip="History">
                            <PathIcon Data="M11.99,2C6.47,2 2,6.48 2,12C2,17.52 6.47,22 11.99,22C17.52,22 22,17.52 22,12C22,6.48 17.52,2 11.99,2M12,20C7.58,20 4,16.42 4,12C4,7.58 7.58,4 12,4C16.42,4 20,7.58 20,12C20,16.42 16.42,20 12,20M12.5,7H11V13L16.25,16.15L17,14.92L12.5,12.25V7Z" Width="14" Height="14" Foreground="#333" />
                        </Button>
                        <Button Classes="IconBtn" Click="ShowDownloadList_Click" ToolTip.Tip="Downloads">
                            <PathIcon Data="M19,9H15V3H9V9H5L12,16L19,9M5,18V20H19V18H5Z" Width="14" Height="14" Foreground="#333" />
                        </Button>
                        <Button Classes="IconBtn" Click="ShowSavedPasswords_Click" ToolTip.Tip="Saved passwords">
                            <PathIcon Data="M12,1A5,5 0 0,0 7,6C7,7.85 8,9.46 9.5,10.32V13H7V16H4V19H7V22H13V16.5L14.5,15C17.5,13.94 19,10.85 19,8A7,7 0 0,0 12,1M12,4A2,2 0 1,1 12,8A2,2 0 0,1 12,4Z" Width="15" Height="15" Foreground="#333" />
                        </Button>
                        <Button Classes="IconBtn" Click="ShowExtensionList_Click" ToolTip.Tip="Extensions">
                            <PathIcon Data="M18,6H16C16,3.79 14.21,2 12,2C9.79,2 8,3.79 8,6H6C4.9,6 4,6.9 4,8V20C4,21.1 4.9,22 6,22H18C19.1,22 20,21.1 20,20V8C20,6.9 19.1,6 18,6M12,4C13.1,4 14,4.9 14,6H10C10,4.9 10.9,4 12,4M18,20H6V8H8V10C8,10.55 8.45,11 9,11C9.55,11 10,10.55 10,10V8H14V10C14,10.55 14.45,11 15,11C15.55,11 16,10.55 16,10V8H18V20Z" Width="14" Height="14" Foreground="#333" />
                        </Button>
                        <Button Classes="IconBtn" Click="GpuInfoButton_Click" ToolTip.Tip="GPU Info (chrome://gpu)">
                            <PathIcon Data="M17,17H7V7H17M21,11V9H19V7C19,5.89 18.1,5 17,5H15V3H13V5H11V3H9V5H7C5.89,5 5,5.89 5,7V9H3V11H5V13H3V15H5V17A2,2 0 0,0 7,19H9V21H11V19H13V21H15V19H17A2,2 0 0,0 19,17V15H21V13H19V11M13,13H11V11H13V13Z" Width="14" Height="14" Foreground="#1565C0" />
                        </Button>
                    </StackPanel>
                    

                <!-- Extensions Toolbar -->
                <ItemsControl Grid.Column="6" ItemsSource="{Binding Extensions}" Margin="8,0,0,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ExtensionItemViewModel">
                            <Button Click="ExtensionToolbarButton_Click" Tag="{Binding Id}" Background="Transparent" Width="28" Height="28" CornerRadius="14" Padding="4" Cursor="Hand" ToolTip.Tip="{Binding Name}">
                                <!-- Icon logic for Extension Toolbar -->
                                <Grid>
                                    <Image Source="{Binding Icon}" Width="20" Height="20" VerticalAlignment="Center">
                                        <Image.IsVisible>
                                            <Binding Path="Icon" Converter="{x:Static ObjectConverters.IsNotNull}" />
                                        </Image.IsVisible>
                                    </Image>
                                    <PathIcon Data="M18,6H16C16,3.79 14.21,2 12,2C9.79,2 8,3.79 8,6H6C4.9,6 4,6.9 4,8V20C4,21.1 4.9,22 6,22H18C19.1,22 20,21.1 20,20V8C20,6.9 19.1,6 18,6M12,4C13.1,4 14,4.9 14,6H10C10,4.9 10.9,4 12,4M18,20H6V8H8V10C8,10.55 8.45,11 9,11C9.55,11 10,10.55 10,10V8H14V10C14,10.55 14.45,11 15,11C15.55,11 16,10.55 16,10V8H18V20Z" Width="16" Height="16" Foreground="#555">
                                        <PathIcon.IsVisible>
                                            <Binding Path="Icon" Converter="{x:Static ObjectConverters.IsNull}" />
                                        </PathIcon.IsVisible>
                                    </PathIcon>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>


                    <!-- List Items -->

                    <Border Height="1" Margin="4,10,4,6" Background="#00D0D0D0" IsHitTestVisible="False" />

                    <Button Classes="ListItem" Click="ReopenClosedTab_Click"
                            IsVisible="{Binding CanReopenClosedTab}"
                            ToolTip.Tip="{Binding ReopenClosedTabTip}">
                        <Grid ColumnDefinitions="32,*,Auto">
                            <PathIcon Data="M13,3A9,9 0 0,0 4,12H1L5,16L9,12H6A7,7 0 1,1 8.05,16.95L6.63,18.37A9,9 0 1,0 13,3M12,8V12.4L15,14.2L16,12.6L14,11.4V8H12Z" Width="16" Height="16" Foreground="#666" />
                            <TextBlock Grid.Column="1" Text="Re-open closed tab" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Ctrl+Shift+T" VerticalAlignment="Center" Margin="28,0,0,0" Foreground="#888888" FontSize="12" />
                        </Grid>
                    </Button>

                    <Border Height="1" Margin="4,10,4,6" Background="#00D0D0D0" IsHitTestVisible="False" IsVisible="{Binding CanReopenClosedTab}" />
                    <Button Name="AiFunctionButton" Classes="ListItem" Click="AiFunction_Click">
                        <Grid ColumnDefinitions="32,*,Auto">
                            <PathIcon Data="M12,17.27L18.18,21L16.54,13.97L22,9.24L14.81,8.62L12,2L9.19,8.62L2,9.24L7.46,13.97L5.82,21L12,17.27Z" Width="16" Height="16" Foreground="#666"/>
                            <TextBlock Grid.Column="1" Text="AI Function" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="Ctrl+Shift+I" VerticalAlignment="Center" Margin="28,0,0,0" Foreground="#888888" FontSize="12" />
                        </Grid>
                    </Button>
                    <Border Height="1" Margin="4,10,4,6" Background="#00D0D0D0" IsHitTestVisible="False" />

                    <Button Classes="ListItem" Click="OpenLinkInNewTab_Click">
                        <Grid ColumnDefinitions="32,*"><PathIcon Data="M19,19H5V5H12V3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V12H19V19M14,3V5H17.59L8.46,14.13L9.87,15.54L19,6.41V10H21V3H14Z" Width="16" Height="16" Foreground="#666"/><TextBlock Grid.Column="1" Text="Open in New tab" VerticalAlignment="Center"/></Grid>
                    </Button>
                    <Button Name="OpenInNewWindowButton" Classes="ListItem" Click="OpenInNewWindow_Click" IsVisible="False">
                        <Grid ColumnDefinitions="32,*"><PathIcon Data="M19,19H5V5H12V3H5C3.9,3 3,3.9 3,5V19C3,20.1 3.9,21 5,21H19C20.1,21 21,20.1 21,19V12H19V19M14,3V5H17.59L8.46,14.13L9.87,15.54L19,6.41V10H21V3H14Z" Width="16" Height="16" Foreground="#666"/><TextBlock Grid.Column="1" Text="Open in New window" VerticalAlignment="Center"/></Grid>
                    </Button>
                    <Button Classes="ListItem" Click="ShowDeviceList_Click">
                        <Grid ColumnDefinitions="32,*"><PathIcon Data="M4,6H20V16H4V6M20,4H4C2.9,4 2,4.9 2,6V16C2,17.1 2.9,18 4,18H10V20H8V22H16V20H14V18H20C21.1,18 22,17.1 22,16V6C22,4.9 21.1,4 20,4Z" Width="16" Height="16" Foreground="#666"/><TextBlock Grid.Column="1" Text="Open in Another device" VerticalAlignment="Center"/></Grid>
                    </Button>
                    <Button Name="OpenOnPinnedWindowButton" Classes="ListItem" Click="OpenOnPinnedWindow_Click" IsVisible="False">
                        <Grid ColumnDefinitions="32,*"><PathIcon Data="M16,12V4H17V2H7V4H8V12L6,14V16H11V22H13V16H18V14L16,12Z" Width="16" Height="16" Foreground="#666"/><TextBlock Grid.Column="1" Text="Open in Pinned window" VerticalAlignment="Center"/></Grid>
                    </Button>

                    <Border Height="1" Margin="4,10,4,6" Background="#00D0D0D0" IsHitTestVisible="False" />

                    <Button Classes="ListItem" Click="NewIncognitoWindow_Click">
                        <Grid ColumnDefinitions="32,*,Auto">
                            <PathIcon Data="M12,2A10,10 0 1,0 22,12A10,10 0 0,0 12,2M12,4A8,8 0 1,1 4,12A8,8 0 0,1 12,4M7,10.5A2.5,2.5 0 0,0 12,11.5A2.5,2.5 0 0,0 17,10.5H15A1,1 0 0,1 13,10.5H11A1,1 0 0,1 9,10.5Z" Width="16" Height="16" Foreground="#666" />
                            <TextBlock Grid.Column="1" Text="New Incognito window" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Ctrl+Shift+N" VerticalAlignment="Center" Margin="28,0,0,0" Foreground="#888888" FontSize="12" />
                        </Grid>
                    </Button>

                    <Button Name="MuteTabButton" Classes="ListItem" Click="MuteTab_Click">
                        <Grid ColumnDefinitions="32,*"><PathIcon Data="M3,9V15H7L12,20V4L7,9H3M16.5,12C16.5,10.23 15.48,8.71 14,7.97V16.02C15.48,15.29 16.5,13.77 16.5,12M14,3.23V5.29C16.89,6.15 19,8.83 19,12C19,15.17 16.89,17.85 14,18.71V20.77C18.01,19.86 21,16.28 21,12C21,7.72 18.01,4.14 14,3.23Z" Width="16" Height="16" Foreground="#666"/><TextBlock Name="MuteTabLabel" Grid.Column="1" Text="Mute this tab" VerticalAlignment="Center"/></Grid>
                    </Button>

                    <Border Height="1" Margin="4,10,4,6" Background="#00D0D0D0" IsHitTestVisible="False"/>

                    <Button Classes="ListItem" Click="CopyButton_Click">
                        <Grid ColumnDefinitions="32,*,Auto">
                            <PathIcon Data="M16,1H4C2.9,1 2,1.9 2,3V17H4V3H16V1M19,5H8C6.9,5 6,5.9 6,7V21C6,22.1 6.9,23 8,23H19C20.1,23 21,22.1 21,21V7C21,5.9 20.1,5 19,5M19,21H8V7H19V21Z" Width="16" Height="16" Foreground="#666" />
