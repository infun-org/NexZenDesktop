                        </Grid>
                    </Button>
                    <Button Classes="ListItem" Click="PasteButton_Click">
                        <Grid ColumnDefinitions="32,*,Auto">
                            <PathIcon Data="M19,4H17.82C17.4,2.84 16.3,2 15,2H9C7.7,2 6.6,2.84 6.18,4H5C3.9,4 3,4.9 3,6V20C3,21.1 3.9,22 5,22H19C20.1,22 21,21.1 21,20V6C21,4.9 20.1,4 19,4M9,4H15V6H9V4M19,20H5V6H7V8H17V6H19V20Z" Width="16" Height="16" Foreground="#666" />
                            <TextBlock Grid.Column="1" Text="Paste" VerticalAlignment="Center" />
