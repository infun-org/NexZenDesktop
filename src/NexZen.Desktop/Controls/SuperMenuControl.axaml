                        </Grid>
                    </Button>
                    <Button Classes="ListItem" Click="CutButton_Click">
                        <Grid ColumnDefinitions="32,*,Auto">
                            <PathIcon Data="M6.5,3A3.5,3.5 0 0,0 3,6.5A3.5,3.5 0 0,0 6.5,10C7.1,10 7.66,9.84 8.14,9.57L10.59,12L8.14,14.43C7.66,14.16 7.1,14 6.5,14A3.5,3.5 0 1,0 10,17.5C10,16.9 9.84,16.34 9.57,15.86L12,13.41L17.59,19H21V17.59L8.14,4.73C8.76,3.7 7.74,3 6.5,3M6.5,8A1.5,1.5 0 1,1 8,6.5A1.5,1.5 0 0,1 6.5,8M6.5,19A1.5,1.5 0 1,1 8,17.5A1.5,1.5 0 0,1 6.5,19M14.41,11L21,4.41V3H19.59L13,9.59Z" Width="16" Height="16" Foreground="#666" />
